---
import PageHero from "../../components/common/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact Us"
  description="Contact SmileCraft Dental Clinic for appointments and dental queries."
>

<PageHero
  title="Contact Us"
  subtitle="Get in touch with our dental team."
/>


<!-- Contact Section -->

<section class="bg-white py-20">

<div class="container mx-auto px-5 lg:px-8">


<div class="grid gap-10 lg:grid-cols-2">


<!-- Details -->

<div>


<h2 class="text-3xl font-bold text-text-primary">
Contact Information
</h2>


<div class="mt-8 space-y-6">


<div class="rounded-2xl border border-border p-5">

<h3 class="font-semibold text-text-primary">
📍 Clinic Address
</h3>

<p class="mt-2 text-text-secondary">
123 Dental Street, Your City, India
</p>

</div>



<div class="rounded-2xl border border-border p-5">

<h3 class="font-semibold text-text-primary">
📞 Phone Number
</h3>

<p class="mt-2 text-text-secondary">
+91 98765 43210
</p>

</div>



<div class="rounded-2xl border border-border p-5">

<h3 class="font-semibold text-text-primary">
🕒 Clinic Timing
</h3>

<p class="mt-2 text-text-secondary">
Monday - Saturday : 9 AM - 8 PM
</p>

</div>


</div>


</div>




<!-- Form -->


<div
class="rounded-3xl border border-border bg-white p-8 shadow-lg"
>


<h2 class="text-2xl font-bold text-text-primary">
Send Message
</h2>



<form id="contactForm"
class="mt-6 space-y-5"
method="POST">


<input
name="name"
type="text"
placeholder="Your Name"
class="w-full rounded-xl border border-border px-5 py-3 outline-none focus:border-primary"
/>



<input
name="email"
type="email"
placeholder="Email Address"
class="w-full rounded-xl border border-border px-5 py-3 outline-none focus:border-primary"
/>



<input
name="phone"
type="tel"
placeholder="Phone Number"
class="w-full rounded-xl border border-border px-5 py-3 outline-none focus:border-primary"
/>



<textarea
name="message"
rows="5"
placeholder="Your Message"
class="w-full rounded-xl border border-border px-5 py-3 outline-none focus:border-primary"
></textarea>



<button
type="submit"
class="w-full rounded-full bg-primary py-3 font-semibold text-white hover:bg-primary-dark"
>
Send Message
</button>


</form>


<script>

const form = document.querySelector("#contactForm");


form?.addEventListener("submit", async (e) => {

  e.preventDefault();


  const formData = new FormData(form);


  const data = {

    name: formData.get("name"),

    email: formData.get("email"),

    phone: formData.get("phone"),

    message: formData.get("message"),

  };



  try {


    const response = await fetch("/api/contact", {

      method: "POST",

      headers: {

        "Content-Type": "application/json",

      },

      body: JSON.stringify(data),

    });



const result = await response.json();
    if(result.success){


      alert("Message sent successfully!");


      form.reset();


    } else {


      alert(
        result.error || "Something went wrong!"
      );


    }



  } catch(error) {


    console.error(error);


    alert("Server error occurred!");


  }


});


</script>

</div>


</div>


</div>


</section>




<!-- Google Map -->

<section class="bg-background-light py-16">


<div class="container mx-auto px-5 lg:px-8">


<div class="overflow-hidden rounded-3xl shadow-lg">


<iframe
src="https://www.google.com/maps/embed?pb="
class="h-[400px] w-full border-0"
loading="lazy"
>
</iframe>


</div>


</div>


</section>


</BaseLayout>