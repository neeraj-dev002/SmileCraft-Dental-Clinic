---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>

<section class="bg-background-light py-20 reveal ">

  <div class="container mx-auto px-5 lg:px-8">


    <div class="grid items-center gap-12 lg:grid-cols-2">


      <!-- Content -->

      <div>

        <span
          class="rounded-full bg-primary-light px-4 py-2 text-sm font-medium text-primary"
        >
          About SmileCraft
        </span>


        <h1
          class="mt-6 text-4xl font-bold text-text-primary sm:text-5xl"
        >
          Creating Healthy Smiles With Expert Dental Care
        </h1>


        <p
          class="mt-6 text-lg leading-8 text-text-secondary"
        >
          SmileCraft Dental Clinic provides advanced dental treatments
          with modern technology and experienced dental professionals.
          Our goal is to make every dental experience comfortable and stress-free.
        </p>


        <a
          href="/appointment"
          class="mt-8 inline-block rounded-full bg-primary px-7 py-3 font-semibold text-white hover:bg-primary-dark"
        >
          Book Appointment
        </a>


      </div>



      <!-- Image -->

      <div>

        <img
          src="/images/gallery/clinic.webp"
          alt="SmileCraft Dental Clinic"
          class="rounded-3xl shadow-lg"
        />

      </div>


    </div>


  </div>

</section>



<!-- Mission Vision -->


<section class="bg-white py-20">

<div class="container mx-auto px-5 lg:px-8">

<div class="grid gap-8 md:grid-cols-2">


<div
class="rounded-2xl border border-border p-8"
>

<h2 class="text-2xl font-bold text-text-primary">
Our Mission
</h2>

<p class="mt-4 text-text-secondary">
To provide high-quality dental care with compassion,
advanced technology and patient-focused treatments.
</p>

</div>



<div
class="rounded-2xl border border-border p-8"
>

<h2 class="text-2xl font-bold text-text-primary">
Our Vision
</h2>

<p class="mt-4 text-text-secondary">
To become a trusted dental clinic known for excellence,
innovation and exceptional patient care.
</p>

</div>


</div>

</div>

</section>


</BaseLayout>