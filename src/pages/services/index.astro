---
import PageHero from "../../components/common/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const services = [
  {
    icon: "🦷",
    title: "Root Canal Treatment",
    description:
      "Advanced root canal treatment to save damaged teeth with comfortable procedures."
  },
  {
    icon: "✨",
    title: "Teeth Whitening",
    description:
      "Professional teeth whitening treatment for a brighter and confident smile."
  },
  {
    icon: "😁",
    title: "Dental Implants",
    description:
      "Natural-looking dental implants to restore missing teeth permanently."
  },
  {
    icon: "🦷",
    title: "Braces Treatment",
    description:
      "Modern orthodontic solutions to improve teeth alignment and smile."
  },
  {
    icon: "👶",
    title: "Kids Dentistry",
    description:
      "Gentle dental care specially designed for children."
  },
  {
    icon: "😁",
    title: "Smile Designing",
    description:
      "Customized cosmetic dentistry to create your perfect smile."
  }
];
---

<BaseLayout
  title="Dental Services"
  description="Explore our dental treatments including root canal, implants, braces and whitening."
>
<PageHero
  title="Our Services"
  subtitle="Comprehensive dental treatments for every member of your family."
/>

<!-- Hero -->

<section class="bg-background-light py-20">

  <div class="container mx-auto px-5 text-center lg:px-8">

    <span
      class="rounded-full bg-primary-light px-4 py-2 text-sm font-medium text-primary"
    >
      Our Services
    </span>


    <h1
      class="mt-6 text-4xl font-bold text-text-primary sm:text-5xl"
    >
      Complete Dental Care Solutions
    </h1>


    <p
      class="mx-auto mt-5 max-w-2xl text-text-secondary"
    >
      We provide advanced dental treatments with modern technology
      and experienced dental professionals.
    </p>

  </div>

</section>



<!-- Services -->

<section class="bg-white py-20">

<div class="container mx-auto px-5 lg:px-8">

<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">


{
services.map((service)=>(
  
<div
class="rounded-2xl border border-border bg-white p-7 shadow-sm transition hover:-translate-y-2 hover:shadow-xl"
>

<div
class="flex h-14 w-14 items-center justify-center rounded-xl bg-primary-light text-3xl"
>
{service.icon}
</div>


<h2
class="mt-6 text-xl font-bold text-text-primary"
>
{service.title}
</h2>


<p
class="mt-3 text-sm leading-6 text-text-secondary"
>
{service.description}
</p>


<a
href="/appointment"
class="mt-5 inline-block font-medium text-primary hover:text-primary-dark"
>
Book Treatment →
</a>


</div>

))
}


</div>

</div>

</section>



<!-- CTA -->

<section class="bg-primary py-16">

<div class="container mx-auto px-5 text-center">


<h2 class="text-3xl font-bold text-white">
Ready For A Healthy Smile?
</h2>


<p class="mt-4 text-white/80">
Book your appointment with our expert dentists today.
</p>


<a
href="/appointment"
class="mt-7 inline-block rounded-full bg-white px-8 py-3 font-semibold text-primary"
>
Book Appointment
</a>


</div>

</section>


</BaseLayout>