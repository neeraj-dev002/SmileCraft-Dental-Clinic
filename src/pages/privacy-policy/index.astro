---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/common/PageHero.astro";
---

<BaseLayout>

<PageHero
title="Privacy Policy"
subtitle="Your privacy is important to us."
/>

<section class="py-20">

<div class="container mx-auto max-w-4xl px-5">

<div class="prose max-w-none">

<h2>Information We Collect</h2>

<p>
We collect only the information necessary to provide dental services
and respond to appointment requests.
</p>

<h2>How We Use Information</h2>

<ul>
<li>Appointment Booking</li>
<li>Patient Communication</li>
<li>Service Improvement</li>
</ul>

<h2>Data Security</h2>

<p>
Your information is securely stored and never shared without consent.
</p>

</div>

</div>

</section>

</BaseLayout>