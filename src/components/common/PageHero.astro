---
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<section class="relative overflow-hidden bg-primary py-24">

  <div class="absolute inset-0 bg-[url('/images/patterns/grid.svg')] opacity-10"></div>

  <div class="container relative mx-auto px-5 text-center lg:px-8">

    <nav class="mb-5 text-sm text-white/80">
      <a href="/" class="hover:text-white">
        Home
      </a>

      <span class="mx-2">/</span>

      <span>
        {title}
      </span>
    </nav>

    <h1 class="text-4xl font-bold text-white lg:text-5xl">
      {title}
    </h1>

    <p class="mx-auto mt-5 max-w-2xl text-lg text-white/80">
      {subtitle}
    </p>

  </div>

</section>