---
---

<section class="relative overflow-hidden bg-background-light reveal ">

  <div class="container mx-auto px-5 py-20 lg:px-8 lg:py-28">

    <div class="grid items-center gap-12 lg:grid-cols-2">


      <!-- Left Content -->

      <div>

        <span
          class="inline-flex rounded-full bg-secondary-light px-4 py-2 text-sm font-medium text-secondary-dark"
        >
          🦷 Trusted Dental Care
        </span>


        <h1
          class="mt-6 text-4xl font-bold leading-tight text-text-primary sm:text-5xl lg:text-6xl"
        >
          Your Perfect Smile
          <span class="text-primary">
            Starts Here
          </span>
        </h1>


        <p
          class="mt-6 max-w-xl text-lg leading-relaxed text-text-secondary"
        >
          Experience advanced dental treatments with expert dentists,
          modern technology, and personalized care for your healthy smile.
        </p>


        <div class="mt-8 flex flex-wrap gap-4">

          <a
            href="/appointment"
            class="rounded-full bg-primary px-7 py-3.5 font-semibold text-white shadow-md transition hover:bg-primary-dark"
          >
            Book Appointment
          </a>


          <a
            href="tel:+919876543210"
            class="rounded-full border border-border bg-white px-7 py-3.5 font-semibold text-text-primary transition hover:border-primary hover:text-primary"
          >
            Call Now
          </a>

        </div>


        <!-- Trust Stats -->

        <div class="mt-10 grid grid-cols-3 gap-5">


          <div>
            <h3 class="text-2xl font-bold text-primary">
              10+
            </h3>
            <p class="text-sm text-text-secondary">
              Years Experience
            </p>
          </div>


          <div>
            <h3 class="text-2xl font-bold text-primary">
              5K+
            </h3>
            <p class="text-sm text-text-secondary">
              Happy Patients
            </p>
          </div>


          <div>
            <h3 class="text-2xl font-bold text-primary">
              15+
            </h3>
            <p class="text-sm text-text-secondary">
              Treatments
            </p>
          </div>


        </div>


      </div>



      <!-- Right Image -->

      <div class="relative">


        <div
          class="absolute -left-5 -top-5 h-40 w-40 rounded-full bg-secondary-light blur-3xl"
        ></div>


        <img
          src="/images/hero/dentist.jpg"
          alt="Professional Dentist"
          class="relative mx-auto w-full max-w-lg rounded-3xl object-cover shadow-lg"
        />


        <!-- Floating Card -->

        <div
          class="absolute bottom-6 left-5 rounded-2xl bg-white p-4 shadow-lg"
        >

          <div class="flex items-center gap-3">

            <div
              class="flex h-12 w-12 items-center justify-center rounded-full bg-primary text-white"
            >
              ⭐
            </div>

            <div>
              <p class="font-bold text-text-primary">
                4.9/5 Rating
              </p>

              <p class="text-sm text-text-secondary">
                Patient Reviews
              </p>
            </div>

          </div>

        </div>


      </div>


    </div>

  </div>

</section>