---
const services = [
  {
    icon: "🦷",
    title: "Teeth Cleaning",
    description:
      "Professional cleaning to remove plaque, stains and maintain healthy gums.",
    link: "/services/teeth-cleaning"
  },
  {
    icon: "⚕️",
    title: "Root Canal Treatment",
    description:
      "Advanced root canal procedures to save damaged teeth with minimal discomfort.",
    link: "/services/root-canal"
  },
  {
    icon: "✨",
    title: "Teeth Whitening",
    description:
      "Brighten your smile with safe and effective whitening treatments.",
    link: "/services/teeth-whitening"
  },
  {
    icon: "😁",
    title: "Dental Implants",
    description:
      "Natural-looking and durable dental implants for missing teeth.",
    link: "/services/dental-implants"
  },
  {
    icon: "🦷",
    title: "Braces Treatment",
    description:
      "Correct alignment issues with modern orthodontic solutions.",
    link: "/services/braces"
  },
  {
    icon: "👶",
    title: "Kids Dentistry",
    description:
      "Gentle dental care specially designed for children.",
    link: "/services/kids-dentistry"
  }
];
---

<section class="bg-background-light py-20 lg:py-28">

  <div class="container mx-auto px-5 lg:px-8">


    <!-- Heading -->

    <div class="mx-auto max-w-2xl text-center">

      <span
        class="inline-flex rounded-full bg-primary-light px-4 py-2 text-sm font-medium text-primary"
      >
        Our Services
      </span>


      <h2
        class="mt-5 text-3xl font-bold text-text-primary sm:text-4xl"
      >
        Complete Dental Care Solutions
      </h2>


      <p
        class="mt-4 text-text-secondary"
      >
        From preventive care to advanced dental treatments, we provide
        complete solutions for your oral health.
      </p>

    </div>



    <!-- Service Cards -->

    <div
      class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
    >

      {
        services.map((service) => (

          <div
            class="group rounded-2xl bg-white p-7 shadow-sm border border-border transition hover:-translate-y-2 hover:shadow-xl"
          >


            <div
              class="flex h-14 w-14 items-center justify-center rounded-xl bg-primary-light text-3xl"
            >
              {service.icon}
            </div>



            <h3
              class="mt-6 text-xl font-semibold text-text-primary"
            >
              {service.title}
            </h3>



            <p
              class="mt-3 text-sm leading-6 text-text-secondary"
            >
              {service.description}
            </p>



            <a
              href={service.link}
              class="mt-5 inline-flex items-center font-medium text-primary hover:text-primary-dark"
            >
              Learn More →
            </a>


          </div>

        ))
      }


    </div>


  </div>

</section>