---
import MobileMenu from './MobileMenu.astro';
const navLinks = [
  {
    name: "Home",
    url: "/"
  },
  {
    name: "About",
    url: "/about"
  },
  {
    name: "Services",
    url: "/services"
  },
  {
    name: "Doctors",
    url: "/doctors"
  },
  {
    name: "Contact",
    url: "/contact"
  }
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white shadow-sm">

<div class="container mx-auto flex items-center justify-between px-5 py-5 lg:px-8">


<!-- Logo -->

<a
href="/"
class="text-2xl font-bold text-primary"
>
SmileCraft
</a>



<!-- Desktop Menu -->

<nav class="hidden items-center gap-8 md:flex">

{
navLinks.map((link)=>(
  
<a
href={link.url}
class:list={[
  "font-medium transition",
  currentPath === link.url
  ? "text-primary"
  : "text-text-secondary hover:text-primary"
]}
>
{link.name}
</a>

))
}

</nav>



<!-- Appointment Button -->

<a
href="/appointment"
class="rounded-full bg-primary px-6 py-3 font-semibold text-white hover:bg-primary-dark"
>
Book Appointment
</a>

<MobileMenu/>

</div>

</header>